config_version=5

[application]
config/name="Island Lab"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="A small seeded island surrounded by water."

[display]
window/size/viewport_width=1200
window/size/viewport_height=850
window/size/window_width_override=1200
window/size/window_height_override=850
window/size/min_width=240
window/size/min_height=240
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.149, 0.596, 0.933, 1)
